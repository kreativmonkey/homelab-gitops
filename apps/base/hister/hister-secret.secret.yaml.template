# Generate the SOPS-encrypted Secret; never commit the plaintext token:
#   just sops-create hister-secret hister HISTER_ACCESS_TOKEN='<random-token>'
#   mv hister-secret.secret.yaml apps/base/hister/
apiVersion: v1
kind: Secret
metadata:
  name: hister-secret
  namespace: hister
type: Opaque
stringData:
  HISTER_ACCESS_TOKEN: replace-with-a-random-token

# Generate the SOPS-encrypted Secret; never commit plaintext values.
# From repo root with SOPS_AGE_KEY_FILE set:
#   just sops-create vikunja-secret vikunja \
#     client-id=homelab-vikunja \
#     client-secret="$(openssl rand -base64 32 | tr -d '\n')" \
#     jwt-secret="$(openssl rand -base64 48 | tr -d '\n')"
#   mv vikunja-secret.secret.yaml apps/base/vikunja/
#
# Mirror the SAME client-secret into the private repo
# (apps/overlays/main/authentik-private/oidc-client-secrets.secret.yaml, key
# OIDC_VIKUNJA_CLIENT_SECRET); the Authentik blueprint reads it via !Env.
apiVersion: v1
kind: Secret
metadata:
  name: vikunja-secret
  namespace: vikunja
type: Opaque
stringData:
  client-id: homelab-vikunja
  client-secret: replace-with-a-random-client-secret
  jwt-secret: replace-with-a-random-jwt-secret
